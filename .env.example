# ──────────────────────────────────────────────────────────────
# Alpaca credentials — copy to .env and fill in. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# Required: API key + secret from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Paper vs live. Defaults to true (paper). To go live you MUST also set
# I_UNDERSTAND_THIS_IS_LIVE=yes  — this friction is intentional.
ALPACA_PAPER=true
# I_UNDERSTAND_THIS_IS_LIVE=yes

# Optional: override the data feed. "iex" is free; "sip" requires a paid plan.
ALPACA_DATA_FEED=iex

# Kill-switch bearer token (FastAPI /kill endpoint). Generate a long random string.
KILL_SWITCH_TOKEN=change_me_to_a_long_random_string

# Optional: where the SQLite trade log lives. Switch to a Postgres DSN for prod.
DATABASE_URL=sqlite:///./trading_bot.sqlite

# Optional logging knob
LOG_LEVEL=INFO
